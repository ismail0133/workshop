# PHASE 1 : paramètres non secrets.
COMPOSE_PROJECT_NAME=resilience-alpha
TZ=UTC
# Images de la future observabilité ; PostgreSQL/Python sont figés dans Compose/Dockerfile.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
LOKI_IMAGE=grafana/loki:3.5.3
ALLOY_IMAGE=grafana/alloy:v1.10.2
# Futur ingress : loopback Mac ; utiliser IP exacte du PA pour Windows.
WAF_BIND_IP=127.0.0.1
WAF_HTTPS_PORT=8443
# L'adresse attaquant n'est jamais préremplie automatiquement.
LAB_ATTACKER_IP=
GROUP_NUMBER=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
OLLAMA_NO_CLOUD=1
# Secrets locaux : générer avec scripts/prepare_secrets.py ; aucune valeur ici.
POSTGRES_PASSWORD_FILE=./infrastructure/secrets/runtime/postgres_password
GRAFANA_PASSWORD_FILE=./infrastructure/secrets/runtime/grafana_password
