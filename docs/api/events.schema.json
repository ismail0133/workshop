  "$defs": {
    "Anomaly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "ANOMALY_DETECTED"
          ]
        },
        "service": {
          "type": "string",
          "enum": [
            "payment-api"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "isolation_forest"
              ]
            },
            "version": {
              "type": "string"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "decision_score": {
              "type": "number"
            },
            "threshold": {
              "type": "number"
            },
            "is_anomaly": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "name",
            "version",
            "artifact_sha256",
            "decision_score",
            "threshold",
            "is_anomaly"
          ]
        },
        "features": {
          "$ref": "#/$defs/Features"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "service",
        "timestamp",
        "window_start",
        "window_end",
        "model",
        "features"
      ]
    },
    "Features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_rate": {
          "type": "number",
          "minimum": 0
        },
        "http_5xx_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "http_4xx_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "cpu_usage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "memory_usage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "active_requests": {
          "type": "number",
          "minimum": 0
        },
        "payment_failure_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "request_rate",
        "http_5xx_rate",
        "http_4xx_rate",
        "latency_p95_ms",
        "cpu_usage_percent",
        "memory_usage_percent",
        "active_requests",
        "payment_failure_rate"
      ]
    }
