          },
          "expr": "{service=\"waf\"} | json | status=~\"4..|5..\"",
          "queryType": "range",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
