        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rate-limited 429 (last 5 min)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"waf\"} | json | status=\"429\" [5m]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
