    {
      "id": 10,
      "type": "logs",
      "title": "Refused or failed requests (status 4xx / 5xx)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
